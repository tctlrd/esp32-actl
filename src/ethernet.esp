// React to Ethernet events:
void WiFiEvent(WiFiEvent_t event)
{
	switch (event)
	{

	case ARDUINO_EVENT_ETH_START:
		// This will happen during setup, when the Ethernet service starts
		Serial.println("[ INFO ] ETH Started");
		// set eth hostname here
		ETH.setHostname(config.deviceHostname);
		break;

	case ARDUINO_EVENT_ETH_CONNECTED:
		// This will happen when the Ethernet cable is plugged
		Serial.println("[ INFO ] ETH Connected");
		break;

	case ARDUINO_EVENT_ETH_GOT_IP:
		// This will happen when we obtain an IP address through DHCP or start a static IP connection:
		Serial.print("[ INFO ] ETH MAC: ");
		Serial.print(ETH.macAddress());
		Serial.print(", IPv4: ");
		Serial.print(ETH.localIP());
		if (ETH.fullDuplex())
		{
			Serial.print(", FULL_DUPLEX");
		}
		Serial.print(", ");
		Serial.print(ETH.linkSpeed());
		Serial.println("Mbps");
		eth_connected = true;
		break;

	case ARDUINO_EVENT_ETH_DISCONNECTED:
		// This will happen when the Ethernet cable is unplugged
		Serial.println("[ INFO ] ETH Disconnected");
		eth_connected = false;
		break;

	case ARDUINO_EVENT_ETH_STOP:
		// This will happen when the ETH interface is stopped but this never happens
		Serial.println("[ WARN ] ETH Stopped");
		eth_connected = false;
		break;

	default:
		break;
	}
}

void setupEth(bool configured)
{
	// Add a handler for network events. This is misnamed "WiFi" because the ESP32 is historically WiFi only,
	// but in our case, this will react to Ethernet events.
	WiFi.onEvent(WiFiEvent);
#ifdef DEBUG
	Serial.println("[ INFO ] ETH Setup ");
#endif
	ETH.begin(ETH_PHY_ADDR, ETH_PHY_POWER, ETH_PHY_MDC, ETH_PHY_MDIO, ETH_PHY_TYPE, ETH_CLK_MODE);
	if (!config.dhcpEnabledEth)
	{
		ETH.config(config.ipAddressEth, config.gatewayIpEth, config.subnetIpEth, config.dnsIpEth, config.dnsIpEth);
	}
}